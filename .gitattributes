# Keep shell scripts LF even when checked out on Windows, otherwise the Linux CI
# runner fails with "bad interpreter: /bin/sh^M".
* text=auto

*.java      text eol=lf
*.xml       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.properties text eol=lf
*.sh        text eol=lf
mvnw        text eol=lf
Jenkinsfile text eol=lf
Dockerfile  text eol=lf

*.cmd       text eol=crlf
*.bat       text eol=crlf

*.jar       binary
*.png       binary
*.jpg       binary
