{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "login-schema.json",
  "title": "LoginResponse",
  "type": "object",
  "required": ["accessToken", "refreshToken", "id", "username", "email"],
  "properties": {
    "accessToken": {
      "type": "string",
      "minLength": 20,
      "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
    },
    "refreshToken": {
      "type": "string",
      "minLength": 20
    },
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "username": {
      "type": "string",
      "minLength": 1
    },
    "email": {
      "type": "string",
      "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
    },
    "firstName": { "type": "string" },
    "lastName": { "type": "string" },
    "gender": { "type": "string" },
    "image": { "type": "string" }
  },
  "additionalProperties": true
}
