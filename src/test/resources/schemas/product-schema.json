{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "product-schema.json",
  "title": "Product",
  "type": "object",
  "required": [
    "id",
    "title",
    "description",
    "category",
    "price",
    "rating",
    "stock",
    "images",
    "thumbnail"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "price": {
      "type": "number",
      "minimum": 0
    },
    "discountPercentage": {
      "type": "number",
      "minimum": 0
    },
    "rating": {
      "type": "number",
      "minimum": 0
    },
    "stock": {
      "type": "integer",
      "minimum": 0
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "brand": {
      "type": "string"
    },
    "sku": {
      "type": "string"
    },
    "weight": {
      "type": "number",
      "minimum": 0
    },
    "dimensions": {
      "type": "object",
      "properties": {
        "width": { "type": "number" },
        "height": { "type": "number" },
        "depth": { "type": "number" }
      }
    },
    "availabilityStatus": {
      "type": "string"
    },
    "returnPolicy": {
      "type": "string"
    },
    "minimumOrderQuantity": {
      "type": "integer",
      "minimum": 1
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "thumbnail": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
