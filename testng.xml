<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  Full regression suite. This is what CI runs on every pull request and nightly.

  parallel="none" keeps the first experience deterministic. Once the suite is
  trusted, change it to parallel="methods" thread-count="5" and watch for shared
  state - there should be none, because every test owns its own data.
-->
<suite name="API Regression Suite" verbose="1" parallel="none">

  <listeners>
    <listener class-name="com.example.framework.listeners.TestListener"/>
    <listener class-name="com.example.framework.listeners.RetryTransformer"/>
  </listeners>

  <test name="All API Tests">
    <packages>
      <package name="com.example.tests.*"/>
    </packages>
  </test>

</suite>
